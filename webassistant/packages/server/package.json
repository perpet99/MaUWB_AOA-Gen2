{
  "name": "@mauwb/server",
  "version": "1.0.0",
  "private": true,
  "description": "Node host for MaUWB AOA anchors: serial/TCP/replay transports, REST + WebSocket",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
